# Postgres connection string. Supabase transaction pooler (port 6543) works.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Groq API key (free tier works): https://console.groq.com/keys
GROQ_API_KEY=

# Optional: a Vercel AI Gateway model tried before Groq, e.g. anthropic/claude-haiku-5.5
# AI_GATEWAY_MODEL=
